{
  "name": "@saas-instant/portal-auth",
  "version": "1.2.0",
  "private": true,
  "description": "Portal-Anmeldedienst: OIDC-Anbieter (Authorization Code + PKCE, Ed25519-ID-Token) fuer alle Verwaltungen eines Portals.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "dev": "nest start --watch",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.pruefung.json",
    "test": "jest --passWithNoTests && node scripts/integration-run.mjs",
    "test:unit": "jest --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.ts",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@prisma/client": "^5.17.0",
    "@saas-instant/auth-core": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^7.1.0",
    "jose": "^5.10.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@types/qrcode": "^1.5.6",
    "jest": "^29.7.0",
    "otplib": "^12.0.1",
    "prisma": "^5.17.0",
    "ts-jest": "^29.2.3",
    "typescript": "^5.4.5"
  }
}
