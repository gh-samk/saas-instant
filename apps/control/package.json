{
  "name": "@saas-instant/control",
  "version": "0.7.1",
  "private": true,
  "scripts": {
    "build": "nest build && node scripts/copy-fonts.mjs && vite build",
    "build:api": "nest build",
    "build:web": "node scripts/copy-fonts.mjs && vite build",
    "dev": "nest start --watch",
    "dev:web": "vite",
    "start": "node dist/main",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.seed.json && tsc --noEmit -p tsconfig.pruefung.json",
    "test": "pnpm run test:api && pnpm run test:web",
    "test:api": "jest --passWithNoTests && node scripts/integration-run.mjs",
    "test:web": "vitest run",
    "test:integration": "jest --config jest.integration.config.ts",
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "seed:demo": "ts-node --project tsconfig.seed.json prisma/demo-seed.ts",
    "emergency": "node dist/cli/emergency.js",
    "emergency:enrollment": "node dist/cli/emergency.js enrollment",
    "emergency:password": "node dist/cli/emergency.js password",
    "emergency:unlock": "node dist/cli/emergency.js unlock",
    "fonts": "node scripts/copy-fonts.mjs"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.17.0",
    "@saas-instant/shared": "workspace:*",
    "@saas-instant/ui": "workspace:*",
    "@simplewebauthn/server": "^13.1.1",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "fflate": "0.8.2",
    "helmet": "^7.1.0",
    "lucide-react": "^1.23.0",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^9.1.1",
    "otplib": "^12.0.1",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jest": "^29.7.0",
    "jsdom": "^24.1.1",
    "prisma": "^5.17.0",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^2.0.0",
    "vitest-axe": "0.1.0"
  }
}
