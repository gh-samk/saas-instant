# Oberfläche von saas-instant Control. Aufbau wie apps/web/Dockerfile: bauen im
# Node-Image, ausliefern über nginx. Der nginx proxyt /api an control-api:3001,
# daher ist dieser Dienst der einzige, der nach außen gereicht wird.
# Node 22 (LTS) — Node 20 ist seit dem 30.04.2026 End-of-Life ([A.18]).
# Nur die BAUSTUFE; ausgeliefert wird ein nginx-Image.
FROM node:22-alpine AS build
RUN npm install -g pnpm@11.9.0
WORKDIR /app
COPY . .
# Basisdomain der Instanzen (Build-Zeit, siehe docker-compose.yml). Vite liest
# sie als import.meta.env.VITE_INSTANCE_BASE_DOMAIN.
ARG VITE_INSTANCE_BASE_DOMAIN=""
ENV VITE_INSTANCE_BASE_DOMAIN=$VITE_INSTANCE_BASE_DOMAIN
RUN pnpm install --frozen-lockfile --prod=false
# shared muss vor control gebaut werden (control bindet @saas-instant/shared ein).
RUN pnpm --filter @saas-instant/shared build && pnpm --filter @saas-instant/control build:web

# Gepinnt ([Review]): `nginx:alpine` ist die Mainline und wandert bei jedem
# Rebuild — dasselbe Argument wie beim Lockfile.
FROM nginx:1.30.6-alpine
COPY --from=build /app/apps/control/dist-web /usr/share/nginx/html
# Gemeinsame Sicherheits-Kopfzeilen; die Konfiguration bindet sie ein.
COPY ops/nginx/sicherheitskopfzeilen.conf /etc/nginx/snippets/sicherheit.conf
COPY apps/control/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
