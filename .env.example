# Beispielwerte nur zum Prüfen von "docker compose config" (keine echten Geheimnisse).
# Prüfen: docker compose --env-file .env.example config -q
# Die Erstinstallation (install.sh) erzeugt eigene, zufällige Werte in der Instanz-.env.
CONTROL_POSTGRES_PASSWORD=change-me-example
JWT_SECRET=change-me-example-jwt-secret
CONTROL_CONFIG_KEY=change-me-example-config-key
